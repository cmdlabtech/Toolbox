# Cloudflare Pages response headers (also read by `wrangler dev --assets`).
# The CSP limits script to this origin, so injected markup cannot run code that
# reads the credentials held in this browser. connect-src lists every host the
# page talks to: the HPE token endpoints and the Worker (see config.js).
# style-src keeps 'unsafe-inline' for the style attributes in generated SVG.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://central-topology-preview.admin2655.workers.dev https://sso.common.cloud.hpe.com https://global.api.greenlake.hpe.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
